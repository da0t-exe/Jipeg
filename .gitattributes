* text=auto

# Windows reads these, and the console ones must keep CRLF or a stray line
# shows up wrong in cmd.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf

# Unix reads these, and a shell script with CRLF endings does not start at all:
# the interpreter line ends in a carriage return and the kernel looks for
# "/usr/bin/env bash\r". This one line is the difference between the Linux and
# macOS port working and failing before it prints anything.
*.sh text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.js text eol=lf
# et les fichiers de git eux-memes, qui ne se couvraient pas
.gitattributes text eol=lf
.gitignore text eol=lf

# never touched
*.exe binary
*.ico binary
*.png binary
*.gif binary
*.zip binary
