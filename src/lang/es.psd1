    cvMore          = '{0}  (+{1} más en el registro)'
    cvRefused       = 'el codificador lo rechazó (código {0})'
    cvTimeout       = '{0}: el codificador tardó demasiado y se detuvo.'
    cvNoEncoder     = 'No se encontró cjpegli.exe en:'
