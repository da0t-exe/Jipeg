# Jipeg - English, and the reference every other language falls back to.
# One file per language; only the one in use is ever read. A key missing from a
# translation is taken from here, so a half-finished language shows English
# lines rather than blanks.
# the two right-click entries, written into the registry at install time
@{
    verbFile        = 'Convert to JPEG (Jipeg)'
    verbDir         = 'Convert images to JPEG (Jipeg)'

    # the converter window
    cvReady         = 'Getting ready...'
    cvOne           = 'Converting to JPEG...'
    cvMany          = 'Converting to JPEG... ({0} of {1})'
    cvCancelling    = 'Cancelling...'
    cvCancelled     = 'Cancelled - {0}'
    cvDoneOne       = '1 image converted'
    cvDoneMany      = '{0} images converted'
    cvFailOne       = ', 1 failure'
    cvFailMany      = ', {0} failures'
    cvKept          = ', {0} left alone'
    cvKeptNote      = 'JPEG would have been bigger, so the originals were kept.'
    cvMore          = '{0}  (+{1} more in the log)'
    cvRefused       = 'the encoder refused it (exit {0})'
    cvTimeout       = '{0}: the encoder took too long and was stopped.'
    cvNoEncoder     = 'cjpegli.exe was not found at:'
    cvReinstall     = 'Run the Jipeg installer again.'
    btnOK           = 'OK'
    btnCancel       = 'Cancel'

    # the settings window
    stTitle         = 'Jipeg Settings'
    stNoSave        = 'Settings could not be saved.'
    secConv         = 'Conversion'
    lblQuality      = 'JPEG quality'
    hintQuality     = 'Higher keeps more detail and makes bigger files.'
    lblChroma       = 'Colour detail'
    chromaAuto      = 'Follow the source'
    chromaFull      = 'Always full (4:4:4)'
    chromaSmall     = 'Smaller files (4:2:0)'
    hintChroma      = 'Full colour keeps text and sharp edges clean, and costs some size.'
    secAppearance   = 'Appearance'
    lblLanguage     = 'Language'
    langAuto        = 'Automatic (Windows)'
    lblTheme        = 'Theme'
    themeAuto       = 'Follow Windows'
    themeLight      = 'Light'
    themeDark       = 'Dark'
    hintTheme       = 'Takes effect the next time a window opens.'
    chkMica         = 'Translucent window background (Mica)'
    hintMica        = 'The Windows 11 material: the background picks up what is behind it.'
    secUpdates      = 'Updates'
    chkAuto         = 'Install new versions quietly'
    hintAuto        = 'Checked once a day after a conversion, never during one.'
    secFinish       = 'When a conversion finishes'
    chkClose        = 'Close the window automatically'
    hintClose       = 'Otherwise the result stays on screen until you click OK.'
    btnCheck        = 'Check for updates'
    btnUpdate       = 'Update'
    btnUpToDate     = 'Up to date'
    updChecking     = 'Checking for updates...'
    updNoReach      = 'Could not reach GitHub.'
    updAvailable    = 'Version {0} is available.'
    updLatest       = 'You have the latest version.'
    updDownloading  = 'Downloading Jipeg {0}...'
    updNoStart      = 'Could not start the update.'
    updInstalled    = 'Installed. It takes effect the next time you convert.'
    updNothing      = 'Nothing to install right now.'
    updFailed       = 'The update did not go through. Try again later.'

    # the quality list, one line per value
    qCustom         = 'custom'
    q100            = 'maximum, files get very large'
    q96             = 'visually lossless'
    q92             = 'very high quality'
    q90             = 'high quality (default)'
    q85             = 'balanced'
    q80             = 'small files, still crisp'
    q75             = 'light, made for the web'
    q70             = 'strong compression'
    q60             = 'very strong, artefacts show'

    # the installer
    inTitle         = 'Install Jipeg'
    inWhat          = 'Jipeg adds {0} to the right-click menu on images and converts them with Google''s jpegli encoder.'
    inWhere         = 'Installs to: {0}'
    inNoAdmin       = 'No administrator rights required.'
    inChk           = 'Show the entry directly in the right-click menu'
    inChkOld        = 'Classic context menu - not needed on this Windows'
    inChkHint       = 'Otherwise Windows 11 hides it under {0}.'
    inRestart       = 'Explorer restarts: the taskbar and any open folders close, and come back after a few seconds.'
    inShowMore      = 'Show more options'
    inChkHintOld    = 'Your Windows already shows the full menu.'
    btnInstall      = 'Install'
    inDone          = 'Jipeg is installed.'
    inDoneHow       = 'Right-click an image   {0}   {1}'
    inFailed        = 'The installation failed.'

    # the uninstaller
    unTitle         = 'Uninstall Jipeg'
    unAsk           = 'Remove Jipeg?'
    unWhat          = 'The context menu entry and the folder {0} will be deleted.'
    unKeep          = 'Images you already converted are left alone.'
    unDone          = 'Jipeg has been removed.'

    # what a quiet update leaves behind, shown under the Updates section
    trUpdated       = 'Updated to {0} on {1}.'
    trSkipped       = 'Skipped {0}: no checksummed archive published.'
    trRefused       = 'Refused {0}: checksum did not match.'
    trNoInstaller   = 'Skipped {0}: the archive had no installer.'
    trFailed        = 'Update to {0} failed (exit {1}).'
    trCheckFail     = 'Update check failed: {0}'
}
