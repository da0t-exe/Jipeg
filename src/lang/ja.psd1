    unKeep          = 'すでに変換した画像はそのまま残ります。'
    unDone          = 'Jipeg を削除しました。'

    # what a quiet update leaves behind, shown under the Updates section
    trUpdated       = '{1} に {0} へ更新しました。'
    trSkipped       = '{0} をスキップしました: チェックサム付きのアーカイブが公開されていません。'
