    stNoSave        = '設定を保存できませんでした。'
    secConv         = '変換'
    lblQuality      = 'JPEG の品質'
    hintQuality     = '高いほど細部が残り、ファイルは大きくなります。'
    lblChroma       = '色の細かさ'
    chromaAuto      = '元の画像に合わせる'
    chromaFull      = '常にフル (4:4:4)'
    chromaSmall     = 'ファイルを小さく (4:2:0)'
