    cvDoneOne       = '1 件を変換しました'
    cvDoneMany      = '{0} 件を変換しました'
    cvFailOne       = '、失敗 1 件'
    cvFailMany      = '、失敗 {0} 件'
    cvKept          = '、そのまま {0} 件'
    cvKeptNote      = 'JPEG のほうが大きくなるため、元のファイルを残しました。'
    cvMore          = '{0}  (ほか {1} 件はログに)'
    cvRefused       = 'エンコーダーが受け付けませんでした (終了コード {0})'
