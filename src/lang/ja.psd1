    verbFile        = 'JPEG に変換 (Jipeg)'
    verbDir         = '画像を JPEG に変換 (Jipeg)'

    # the converter window
    cvReady         = '準備中...'
    cvOne           = 'JPEG に変換中...'
    cvMany          = 'JPEG に変換中... ({1} 件中 {0} 件)'
