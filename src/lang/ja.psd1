    secUpdates      = '更新'
    chkAuto         = '新しいバージョンを黙って入れる'
    hintAuto        = '変換のあとに 1 日 1 回だけ確認します。変換中は確認しません。'
    secFinish       = '変換が終わったとき'
    chkClose        = 'ウィンドウを自動で閉じる'
    hintClose       = '閉じない場合、OK を押すまで結果が画面に残ります。'
    btnCheck        = '更新を確認'
    btnUpdate       = '更新する'
    btnUpToDate     = '最新です'
    updChecking     = '更新を確認しています...'
